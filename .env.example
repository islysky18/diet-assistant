# Copy this file to .env for local development.
# The real .env file is ignored by Git and must never be committed.
# Replace placeholder values with local-only credentials on each machine.

DIET_ASSISTANT_DB_NAME=diet_assistant
DIET_ASSISTANT_DB_USERNAME=diet_assistant
DIET_ASSISTANT_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DIET_ASSISTANT_DB_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
DIET_ASSISTANT_DB_URL=jdbc:mysql://localhost:3307/diet_assistant
DIET_ASSISTANT_LOCAL_SYNC_TOKEN=REPLACE_WITH_A_LONG_RANDOM_LOCAL_TOKEN
