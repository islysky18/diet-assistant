# Copy this file to .env for local development.
# Replace the example passwords before running shared or persistent environments.

DIET_ASSISTANT_DB_NAME=diet_assistant
DIET_ASSISTANT_DB_USERNAME=diet_assistant
DIET_ASSISTANT_DB_PASSWORD=change-me-local-db-password
DIET_ASSISTANT_DB_ROOT_PASSWORD=change-me-local-root-password
DIET_ASSISTANT_DB_URL=jdbc:mysql://localhost:3307/diet_assistant
